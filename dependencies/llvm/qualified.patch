+  - { id: 0, type: variable-sized, offset: 0, alignment: 64 }
+  - { id: 1, type: spill-slot, size: 128, alignment: 128 }
+body: |
+  bb.0:
+    liveins: $q0
+    $r16 = PS_aligna 64, implicit $r30
+    PS_vstorerq_ai %stack.1, 0, $q0
+...
