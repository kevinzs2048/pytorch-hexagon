+# that precedes it: that loses the scalar update on the target.
+# CHECK-LABEL: name: vector_then_scalar
+# CHECK-NOT: BUNDLE
+# CHECK: V6_vS32b_ai
+# CHECK-NOT: BUNDLE
+# CHECK: S2_storeri_io
+---
+name: vector_then_scalar
+tracksRegLiveness: true
+stack:
+  - { id: 0, type: default, size: 128, alignment: 128 }
+body: |
+  bb.0:
+    liveins: $r0, $r1, $v0
+    V6_vS32b_ai $r0, 0, $v0 :: (store (s1024) into %stack.0, align 128)
+    S2_storeri_io $r0, 64, $r1 :: (store (s32) into %stack.0 + 64)
+...
+
+# CHECK-LABEL: name: scalar_then_vector
+# CHECK-NOT: BUNDLE
+# CHECK: S2_storeri_io
+# CHECK-NOT: BUNDLE
+# CHECK: V6_vS32b_ai
+---
+name: scalar_then_vector
+tracksRegLiveness: true
+stack:
+  - { id: 0, type: default, size: 128, alignment: 128 }
+body: |
+  bb.0:
+    liveins: $r0, $r1, $v0
+    S2_storeri_io $r0, 64, $r1 :: (store (s32) into %stack.0 + 64)
+    V6_vS32b_ai $r0, 0, $v0 :: (store (s1024) into %stack.0, align 128)
+...
+
+# Disjoint stores can still share a packet.
+# CHECK-LABEL: name: disjoint_stores
+# CHECK: BUNDLE
+# CHECK: V6_vS32b_ai
+# CHECK: S2_storeri_io
+---
+name: disjoint_stores
+tracksRegLiveness: true
+stack:
+  - { id: 0, type: default, size: 128, alignment: 128 }
+  - { id: 1, type: default, size: 4, alignment: 4 }
+body: |
+  bb.0:
+    liveins: $r0, $r1, $v0
+    V6_vS32b_ai $r0, 0, $v0 :: (store (s1024) into %stack.0, align 128)
+    S2_storeri_io $r0, 256, $r1 :: (store (s32) into %stack.1)
+...
diff --git a/llvm/test/CodeGen/Hexagon/rdf-copy-partial-redef.mir b/llvm/test/CodeGen/Hexagon/rdf-copy-partial-redef.mir
new file mode 100644
index 0000000000000000000000000000000000000000..ca646ca0b3dc4517bdb4e003879e4ddd8fac241d
--- /dev/null
+++ b/llvm/test/CodeGen/Hexagon/rdf-copy-partial-redef.mir
@@ -0,0 +1,76 @@
+# RUN: llc -mtriple=hexagon -run-pass=hexagon-rdf-opt -verify-machineinstrs %s -o - | FileCheck %s
+#
+# A full-width use can be reached by both the original COPY and a newer
+# subregister definition. Propagating the old source through just one of those
+# shadow edges used to change the entire operand and lose the newer half.
+
+# CHECK-LABEL: name: high_half_redefined
+# CHECK: $r1 = A2_tfrsi -27
+# CHECK: $d3 = COPY {{.*}}$d0
+# CHECK: $r0 = COPY {{.*}}$r7
+---
+name: high_half_redefined
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $r6, $r7
+    $d0 = COPY $d3
+    $r1 = A2_tfrsi -27
+    $d3 = COPY $d0
+    $r0 = COPY $r7
+    J2_jumpr $r31, implicit-def $pc, implicit $r0
+...
+
+# CHECK-LABEL: name: low_half_redefined
+# CHECK: $r0 = A2_tfrsi 123
+# CHECK: $d3 = COPY {{.*}}$d0
+# CHECK: $r0 = COPY {{.*}}$r6
+---
+name: low_half_redefined
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $r6, $r7
+    $d0 = COPY $d3
+    $r0 = A2_tfrsi 123
+    $d3 = COPY $d0
+    $r0 = COPY $r6
+    J2_jumpr $r31, implicit-def $pc, implicit $r0
+...
+
+# Still propagate ordinary, uniquely reaching copies.
+# CHECK-LABEL: name: full_copy_allowed
+# CHECK-NOT: COPY
+# CHECK: $r0 = A2_add {{.*}}$r6, {{.*}}$r6
+---
+name: full_copy_allowed
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $r6
+    $r2 = COPY $r6
+    $r0 = A2_add renamable $r2, renamable $r6
+    J2_jumpr $r31, implicit-def $pc, implicit $r0
+...
+
+# The copied source can itself have multiple reaching definitions. Linking a
+# substituted use to only its last (low-half) definition used to let DCE remove
+# the still-live high-half constant, even though the copy substitution alone
+# was equivalent. The returned value must be incoming r4 + 53.
+# CHECK-LABEL: name: source_halves_defined_separately
+# CHECK: $r7 = A2_tfrsi 53
+# CHECK: $d3 = COPY {{.*}}$d0
+---
+name: source_halves_defined_separately
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $r3, $r4, $r5
+    renamable $r7 = A2_tfrsi 53
+    renamable $r6 = A2_addi renamable $r3, -1
+    renamable $d0 = COPY renamable $d3
+    renamable $d3 = COPY renamable $d0
+    renamable $d0 = COPY renamable $d2
+    renamable $r0 = A2_add renamable $r0, renamable $r7
+    J2_jumpr $r31, implicit-def $pc, implicit $r0
+...
diff --git a/llvm/test/CodeGen/Hexagon/stack-align-ap-entry-spill.ll b/llvm/test/CodeGen/Hexagon/stack-align-ap-entry-spill.ll
new file mode 100644
index 0000000000000000000000000000000000000000..3fbd8d118c0d5219c14e74e7775149320c835c41
--- /dev/null
+++ b/llvm/test/CodeGen/Hexagon/stack-align-ap-entry-spill.ll
@@ -0,0 +1,87 @@
+; RUN: llc -mtriple=hexagon -mcpu=hexagonv73 -O3 < %s | FileCheck %s
+; RUN: llc -mtriple=hexagon -mcpu=hexagonv73 -O3 -stop-after=prologepilog < %s | FileCheck %s --check-prefix=MIR
+;
+; Register allocation may insert spill slots before PS_aligna. Frame-index
+; elimination can then select AP (r16) as their base, so AP must be initialized
+; before the first AP-based spill access.
+;
+; CHECK-LABEL: ap_entry_spill:
+; CHECK-NOT: memw(r16
+; CHECK-NOT: memd(r16
+; CHECK: r16 = and(r30,#-128)
+; CHECK: memw(r16
+;
+; MIR-LABEL: name: ap_entry_spill
+; MIR: S2_storerd_io $r30, -8, killed $d8
+; MIR: $r16 = PS_aligna 128
+; MIR: S2_storeri_io $r16
+
+target triple = "hexagon"
+
+declare void @clobber(ptr)
+
+define i32 @ap_entry_spill(ptr %src, i32 %n) {
+entry:
+  %dynamic = alloca i8, i32 %n, align 128
+  %p0 = getelementptr i32, ptr %src, i32 0
+  %p1 = getelementptr i32, ptr %src, i32 1
+  %p2 = getelementptr i32, ptr %src, i32 2
+  %p3 = getelementptr i32, ptr %src, i32 3
+  %p4 = getelementptr i32, ptr %src, i32 4
+  %p5 = getelementptr i32, ptr %src, i32 5
+  %p6 = getelementptr i32, ptr %src, i32 6
+  %p7 = getelementptr i32, ptr %src, i32 7
+  %p8 = getelementptr i32, ptr %src, i32 8
+  %p9 = getelementptr i32, ptr %src, i32 9
+  %p10 = getelementptr i32, ptr %src, i32 10
+  %p11 = getelementptr i32, ptr %src, i32 11
+  %p12 = getelementptr i32, ptr %src, i32 12
+  %p13 = getelementptr i32, ptr %src, i32 13
+  %p14 = getelementptr i32, ptr %src, i32 14
+  %p15 = getelementptr i32, ptr %src, i32 15
+  %p16 = getelementptr i32, ptr %src, i32 16
+  %p17 = getelementptr i32, ptr %src, i32 17
+  %p18 = getelementptr i32, ptr %src, i32 18
+  %p19 = getelementptr i32, ptr %src, i32 19
+  %v0 = load volatile i32, ptr %p0
+  %v1 = load volatile i32, ptr %p1
+  %v2 = load volatile i32, ptr %p2
+  %v3 = load volatile i32, ptr %p3
+  %v4 = load volatile i32, ptr %p4
+  %v5 = load volatile i32, ptr %p5
+  %v6 = load volatile i32, ptr %p6
+  %v7 = load volatile i32, ptr %p7
+  %v8 = load volatile i32, ptr %p8
+  %v9 = load volatile i32, ptr %p9
+  %v10 = load volatile i32, ptr %p10
+  %v11 = load volatile i32, ptr %p11
+  %v12 = load volatile i32, ptr %p12
+  %v13 = load volatile i32, ptr %p13
+  %v14 = load volatile i32, ptr %p14
+  %v15 = load volatile i32, ptr %p15
+  %v16 = load volatile i32, ptr %p16
+  %v17 = load volatile i32, ptr %p17
+  %v18 = load volatile i32, ptr %p18
+  %v19 = load volatile i32, ptr %p19
+  call void @clobber(ptr %dynamic)
+  %s0 = add i32 %v0, %v1
+  %s1 = add i32 %v2, %v3
+  %s2 = add i32 %v4, %v5
+  %s3 = add i32 %v6, %v7
+  %s4 = add i32 %v8, %v9
+  %s5 = add i32 %v10, %v11
+  %s6 = add i32 %v12, %v13
+  %s7 = add i32 %v14, %v15
+  %s8 = add i32 %v16, %v17
+  %s9 = add i32 %v18, %v19
+  %t0 = add i32 %s0, %s1
+  %t1 = add i32 %s2, %s3
+  %t2 = add i32 %s4, %s5
+  %t3 = add i32 %s6, %s7
+  %t4 = add i32 %s8, %s9
+  %u0 = add i32 %t0, %t1
+  %u1 = add i32 %t2, %t3
+  %u2 = add i32 %u0, %u1
+  %result = add i32 %u2, %t4
+  ret i32 %result
+}
diff --git a/llvm/test/CodeGen/Hexagon/stack-align-late-vector-spill.mir b/llvm/test/CodeGen/Hexagon/stack-align-late-vector-spill.mir
