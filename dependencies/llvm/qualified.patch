diff --git a/llvm/test/CodeGen/Hexagon/vextract-pair-offset.mir b/llvm/test/CodeGen/Hexagon/vextract-pair-offset.mir
new file mode 100644
index 0000000000000000000000000000000000000000..79cfaf1a37910b439588350a21f8fc6fe1cb5de9
--- /dev/null
+++ b/llvm/test/CodeGen/Hexagon/vextract-pair-offset.mir
@@ -0,0 +1,30 @@
+# RUN: llc -mtriple=hexagon -mattr=+hvx,+hvx-length64b -run-pass=hexagon-vextract -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,HVX64
+# RUN: llc -mtriple=hexagon -mattr=+hvx,+hvx-length128b -run-pass=hexagon-vextract -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=CHECK,HVX128
+
+# A vector pair has two nonzero subregister indices. vsub_lo must use the
+# beginning of its spill slot, not the second half. A dynamic byte index must
+# also wrap within one hardware vector, just like V6_extractw itself.
+---
+name: pair_halves
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $w0, $r0
+    %0:hvxwr = COPY $w0
+    %1:intregs = COPY $r0
+    ; CHECK-LABEL: name: pair_halves
+    ; CHECK: PS_vstorerw_ai
+    ; CHECK: %[[LOW:[0-9]+]]:intregs = PS_fi %stack.0, 0
+    ; HVX64: %[[INDEX0:[0-9]+]]:intregs = A2_andir %1, 60
+    ; HVX128: %[[INDEX0:[0-9]+]]:intregs = A2_andir %1, 124
+    ; CHECK: L4_loadri_rr %[[LOW]], %[[INDEX0]], 0
+    %2:intregs = V6_extractw %0.vsub_lo, %1
+    ; HVX64: %[[HIGH:[0-9]+]]:intregs = PS_fi %stack.0, 64
+    ; HVX128: %[[HIGH:[0-9]+]]:intregs = PS_fi %stack.0, 128
+    ; HVX64: %[[INDEX1:[0-9]+]]:intregs = A2_andir %1, 60
+    ; HVX128: %[[INDEX1:[0-9]+]]:intregs = A2_andir %1, 124
+    ; CHECK: L4_loadri_rr %[[HIGH]], %[[INDEX1]], 0
+    %3:intregs = V6_extractw %0.vsub_hi, %1
+    $r0 = A2_add %2, %3
+    J2_jumpr $r31, implicit-def $pc, implicit $r0
+...
diff --git a/mlir/lib/Interfaces/ValueBoundsOpInterface.cpp b/mlir/lib/Interfaces/ValueBoundsOpInterface.cpp
index c9481fb5d9406e7d9c5bdae52d664cf265ad2919..0f8b5149a94d008290e880c9f8518d61252d40d1 100644
--- a/mlir/lib/Interfaces/ValueBoundsOpInterface.cpp
+++ b/mlir/lib/Interfaces/ValueBoundsOpInterface.cpp
@@ -823,6 +823,12 @@ FailureOr<bool> ValueBoundsConstraintSet::strongCompare(const Variable &lhs,
 
 FailureOr<bool> ValueBoundsConstraintSet::areEqual(const Variable &var1,
                                                    const Variable &var2) {
+  // Reflexivity needs no range inference. In particular, repeated comparisons
+  // of identical slice offsets/sizes/strides during bufferization should not
+  // rebuild and solve a Presburger constraint system. Distinct expressions
+  // still use the existing solver, even when they may be equivalent.
+  if (var1.map == var2.map && var1.mapOperands == var2.mapOperands)
+    return true;
   return strongCompare(var1, ComparisonOperator::EQ, var2);
 }
 
