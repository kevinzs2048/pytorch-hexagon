diff --git a/lld/test/ELF/hexagon-thunk-preemptible-defined.s b/lld/test/ELF/hexagon-thunk-preemptible-defined.s
new file mode 100644
index 0000000000000000000000000000000000000000..45adc0906c3f4bad8c9b6e996d234840a5c22956
--- /dev/null
+++ b/lld/test/ELF/hexagon-thunk-preemptible-defined.s
@@ -0,0 +1,25 @@
+# REQUIRES: hexagon
+# RUN: llvm-mc -filetype=obj -triple=hexagon-unknown-elf %s -o %t.o
+# RUN: ld.lld -shared %t.o -o %t.so
+# RUN: llvm-objdump -d --no-show-raw-insn --disassemble-symbols=caller %t.so | FileCheck %s
+#
+# The preemptible definition is nearby, but its PLT entry is beyond B22 range.
+# Range checking must use the effective PLT destination, not the definition.
+# CHECK-LABEL: <caller>:
+# CHECK: call {{.*}}<__hexagon_thunk_target_from_{{.*}}>
+
+.section .text.start,"ax",@progbits
+.globl caller
+.type caller,@function
+caller:
+  call target
+  jumpr r31
+.size caller, .-caller
+.globl target
+.type target,@function
+target:
+  jumpr r31
+.size target, .-target
+
+.section .text.padding,"ax",@progbits
+.space 9000000
