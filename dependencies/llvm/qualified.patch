+SDValue HexagonTargetLowering::LowerFP_TO_BF16(SDValue Op,
+                                                SelectionDAG &DAG) const {
+  SDLoc DL(Op);
+  SDValue Bits = DAG.getNode(ISD::BITCAST, DL, MVT::i32, Op.getOperand(0));
+  SDValue Shift = DAG.getConstant(16, DL, MVT::i32);
+  SDValue Upper = DAG.getNode(ISD::SRL, DL, MVT::i32, Bits, Shift);
+
+  // Round finite values and infinities to nearest, ties to even.  Adding the
+  // retained low bit to 0x7fff implements the tie-breaking rule before the
+  // low 16 bits are discarded.
+  SDValue LowBit = DAG.getNode(ISD::AND, DL, MVT::i32, Upper,
+                               DAG.getConstant(1, DL, MVT::i32));
+  SDValue Bias = DAG.getNode(ISD::ADD, DL, MVT::i32, LowBit,
+                             DAG.getConstant(0x7fff, DL, MVT::i32));
+  SDValue Rounded = DAG.getNode(ISD::ADD, DL, MVT::i32, Bits, Bias);
+  Rounded = DAG.getNode(ISD::SRL, DL, MVT::i32, Rounded, Shift);
+
+  // A plain rounded shift can turn a NaN with a small payload into infinity.
+  // Preserve the upper payload bits and force the quiet-NaN bit instead.
+  SDValue Magnitude = DAG.getNode(ISD::AND, DL, MVT::i32, Bits,
+                                  DAG.getConstant(0x7fffffff, DL, MVT::i32));
+  SDValue IsNaN = DAG.getSetCC(
+      DL, MVT::i1, Magnitude, DAG.getConstant(0x7f800000, DL, MVT::i32),
+      ISD::SETUGT);
+  SDValue QuietNaN = DAG.getNode(ISD::OR, DL, MVT::i32, Upper,
+                                 DAG.getConstant(0x40, DL, MVT::i32));
+  SDValue Result =
+      DAG.getNode(ISD::SELECT, DL, MVT::i32, IsNaN, QuietNaN, Rounded);
+  // Hexagon promotes the softened i16 bfloat payload to i32 registers.
+  return DAG.getAnyExtOrTrunc(Result, DL, Op.getValueType());
