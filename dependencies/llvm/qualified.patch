@@ -0,0 +1,92 @@
+; RUN: llc -mtriple=hexagon < %s | FileCheck %s
+; A word/halfword condition must select all bytes of its logical lane.
+; Values such as i32 -16 or 0x100 have clear bit zero but nonzero upper-byte
+; low bits; a byte-wise predicate test incorrectly mixes the two operands.
+
+target triple = "hexagon"
+
+; CHECK-LABEL: words_128:
+; CHECK: v{{[0-9]+}} = vand(v{{[0-9]+}},v{{[0-9]+}})
+; CHECK: q{{[0-3]}} = vcmp.eq(v{{[0-9]+}}.w,v{{[0-9]+}}.w)
+; CHECK: vmux(
+define void @words_128(ptr %a, ptr %x, ptr %y, ptr %out) #0 {
+ %v = load <32 x i32>, ptr %a, align 128
+ %p = trunc <32 x i32> %v to <32 x i1>
+ %left = load <32 x i32>, ptr %x, align 128
+ %right = load <32 x i32>, ptr %y, align 128
+ %selected = select <32 x i1> %p, <32 x i32> %left, <32 x i32> %right
+ store <32 x i32> %selected, ptr %out, align 128
+ ret void
+}
+
+; CHECK-LABEL: halves_128:
+; CHECK: v{{[0-9]+}} = vand(v{{[0-9]+}},v{{[0-9]+}})
+; CHECK: q{{[0-3]}} = vcmp.eq(v{{[0-9]+}}.h,v{{[0-9]+}}.h)
+; CHECK: vmux(
+define void @halves_128(ptr %a, ptr %x, ptr %y, ptr %out) #0 {
+ %v = load <64 x i16>, ptr %a, align 128
+ %p = trunc <64 x i16> %v to <64 x i1>
+ %left = load <64 x i16>, ptr %x, align 128
+ %right = load <64 x i16>, ptr %y, align 128
+ %selected = select <64 x i1> %p, <64 x i16> %left, <64 x i16> %right
+ store <64 x i16> %selected, ptr %out, align 128
+ ret void
+}
+
+; CHECK-LABEL: bytes_128:
+; CHECK: q{{[0-3]}} = vand(v{{[0-9]+}},r{{[0-9]+}})
+; CHECK: vmux(
+define void @bytes_128(ptr %a, ptr %x, ptr %y, ptr %out) #0 {
+ %v = load <128 x i8>, ptr %a, align 128
+ %p = trunc <128 x i8> %v to <128 x i1>
+ %left = load <128 x i8>, ptr %x, align 128
+ %right = load <128 x i8>, ptr %y, align 128
+ %selected = select <128 x i1> %p, <128 x i8> %left, <128 x i8> %right
+ store <128 x i8> %selected, ptr %out, align 128
+ ret void
+}
+
+; CHECK-LABEL: words_64:
+; CHECK: v{{[0-9]+}} = vand(v{{[0-9]+}},v{{[0-9]+}})
+; CHECK: q{{[0-3]}} = vcmp.eq(v{{[0-9]+}}.w,v{{[0-9]+}}.w)
+; CHECK: vmux(
+define void @words_64(ptr %a, ptr %x, ptr %y, ptr %out) #1 {
+ %v = load <16 x i32>, ptr %a, align 64
+ %p = trunc <16 x i32> %v to <16 x i1>
+ %left = load <16 x i32>, ptr %x, align 64
+ %right = load <16 x i32>, ptr %y, align 64
+ %selected = select <16 x i1> %p, <16 x i32> %left, <16 x i32> %right
+ store <16 x i32> %selected, ptr %out, align 64
+ ret void
+}
+
+; CHECK-LABEL: halves_64:
+; CHECK: v{{[0-9]+}} = vand(v{{[0-9]+}},v{{[0-9]+}})
+; CHECK: q{{[0-3]}} = vcmp.eq(v{{[0-9]+}}.h,v{{[0-9]+}}.h)
+; CHECK: vmux(
+define void @halves_64(ptr %a, ptr %x, ptr %y, ptr %out) #1 {
+ %v = load <32 x i16>, ptr %a, align 64
+ %p = trunc <32 x i16> %v to <32 x i1>
+ %left = load <32 x i16>, ptr %x, align 64
+ %right = load <32 x i16>, ptr %y, align 64
+ %selected = select <32 x i1> %p, <32 x i16> %left, <32 x i16> %right
