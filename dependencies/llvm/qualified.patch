+# RUN: llc -mtriple=hexagon -mattr=+hvxv73,+hvx-length128b -run-pass=if-converter -verify-machineinstrs %s -o - | FileCheck %s
+# VF0 is an implicit HVX register-allocation bookkeeping definition, not an
+# allocatable register with a register class. Predicate-clobber inspection must
+# not try to discover a minimal register class for it.
+# CHECK-LABEL: name: vector_load
+# CHECK: V6_vL32Ub_ai
+# CHECK: implicit-def $vf0
+---
+name: vector_load
+tracksRegLiveness: true
+body: |
+  bb.0:
+    successors: %bb.1, %bb.2
+    liveins: $r0, $r2, $p0
+    J2_jumpf $p0, %bb.2, implicit-def $pc
+    J2_jump %bb.1, implicit-def $pc
+  bb.1:
+    successors: %bb.2
+    liveins: $r0, $r2
+    $v0 = V6_vL32Ub_ai $r2, 256, implicit-def $vf0 :: (load (s1024), align 4)
+    V6_vS32b_ai $r0, 0, $v0 :: (store (s1024), align 128)
+    J2_jump %bb.2, implicit-def $pc
+  bb.2:
+    PS_jmpret $r31, implicit-def dead $pc
+...
diff --git a/llvm/test/CodeGen/Hexagon/native-predicate-bitcast-pack.ll b/llvm/test/CodeGen/Hexagon/native-predicate-bitcast-pack.ll
new file mode 100644
index 000000000000..998af01d9b97
--- /dev/null
+++ b/llvm/test/CodeGen/Hexagon/native-predicate-bitcast-pack.ll
@@ -0,0 +1,41 @@
+; RUN: llc -mtriple=hexagon -O3 -verify-machineinstrs < %s | FileCheck %s
+; RUN: llc -mtriple=hexagon -mattr=+hvxv73,+hvx-length128b -O3 -verify-machineinstrs < %s | FileCheck %s
+;
+; Native predicates replicate each logical lane four times (v2i1) or twice
+; (v4i1).
+; Bitcast must pack one bit per logical lane, not expose replicated bits or
+; widen the native predicate through an unrelated HVX boolean layout.
+
+; CHECK-LABEL: pack2:
+; CHECK: p[[P2:[0-3]]] = vcmpw.eq
+; CHECK: r[[R2:[0-9]+]] = p[[P2]]
+; CHECK-DAG: extractu(r[[R2]],#5,#3)
+; CHECK-DAG: and(r[[R2]],#1)
+; CHECK: or({{.*}},and({{.*}},#2))
+; CHECK: jumpr r31
+
+define i32 @pack2(<2 x i32> %a, <2 x i32> %b) {
+  %p = icmp eq <2 x i32> %a, %b
+  %bits = bitcast <2 x i1> %p to i2
+  %result = zext i2 %bits to i32
+  ret i32 %result
+}
+
+; CHECK-LABEL: pack4:
+; CHECK: p[[P4:[0-3]]] = vcmph.eq
+; CHECK: r[[R4:[0-9]+]] = p[[P4]]
+; CHECK-DAG: extractu(r[[R4]],#7,#1)
+; CHECK-DAG: extractu(r[[R4]],#6,#2)
+; CHECK-DAG: and(r[[R4]],#1)
+; CHECK-DAG: extractu(r[[R4]],#5,#3)
+; CHECK-DAG: or({{.*}},and({{.*}},#2))
+; CHECK: or({{.*}},and({{.*}},#4))
+; CHECK: or({{.*}},and({{.*}},#8))
+; CHECK: jumpr r31
+
+define i32 @pack4(<4 x i16> %a, <4 x i16> %b) {
+  %p = icmp eq <4 x i16> %a, %b
+  %bits = bitcast <4 x i1> %p to i4
+  %result = zext i4 %bits to i32
+  ret i32 %result
+}
