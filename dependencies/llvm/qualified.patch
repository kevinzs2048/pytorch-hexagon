diff --git a/llvm/test/CodeGen/Hexagon/bf16-conversions.ll b/llvm/test/CodeGen/Hexagon/bf16-conversions.ll
new file mode 100644
index 0000000000000000000000000000000000000000..c2c76f23b5e9596a1b8453a2da1d91f91c681843
--- /dev/null
+++ b/llvm/test/CodeGen/Hexagon/bf16-conversions.ll
@@ -0,0 +1,39 @@
+; RUN: llc < %s -mtriple=hexagon -mcpu=hexagonv73 -filetype=obj -o /dev/null
+; RUN: llc < %s -mtriple=hexagon -mcpu=hexagonv73 -O0 | FileCheck %s
+
+; Hexagon has no scalar bfloat instructions. These conversions must be
+; expanded before instruction selection instead of reaching the selector as
+; BF16_TO_FP or FP_TO_BF16 nodes.
+
+define float @bf16_to_f32(ptr %input) {
+entry:
+  %value = load bfloat, ptr %input, align 2
+  %result = fpext bfloat %value to float
+  ret float %result
+}
+
+define void @f32_to_bf16(ptr %output, float %value) {
+; CHECK-LABEL: f32_to_bf16:
+; CHECK: tstbit({{r[0-9]+}},#16)
+; CHECK: ##32767
+; CHECK: lsr({{r[0-9]+}},#16)
+; CHECK: cmp.gtu({{r[0-9]+}},{{.*}}2139095040)
+entry:
+  %result = fptrunc float %value to bfloat
+  store bfloat %result, ptr %output, align 2
+  ret void
+}
+
+define double @bf16_to_f64(ptr %input) {
+entry:
+  %value = load bfloat, ptr %input, align 2
+  %result = fpext bfloat %value to double
+  ret double %result
+}
+
+define void @f64_to_bf16(ptr %output, double %value) {
+entry:
+  %result = fptrunc double %value to bfloat
+  store bfloat %result, ptr %output, align 2
+  ret void
+}
