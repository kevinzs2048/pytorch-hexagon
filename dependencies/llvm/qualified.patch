+# RUN:   FileCheck %s --check-prefix=ZERO
+# RUN: llc -mtriple=hexagon -run-pass=hexagon-bit-simplify \
+# RUN:   -hexbit-bit-transform=false -hexbit-trace-copy-generation \
+# RUN:   -o /dev/null %s 2>&1 | FileCheck %s --check-prefix=TRACE
+# ZERO: HexagonBitSimplify CopyGeneration: copygen: 0 copies
+# ZERO: HexagonBitSimplify CopyGeneration: no_copygen: 0 copies
+# TRACE: copygen[1] bb.0 replace:
+# TRACE-SAME: A2_andir
+# TRACE: source subreg 0:
+# TRACE-SAME: A2_andir
+# TRACE-NOT: copygen[
+
+--- |
+  define i32 @copygen(i32 %x) { ret i32 0 }
+  define i32 @no_copygen(i32 %x) #0 { ret i32 0 }
+  attributes #0 = { "hexagon-no-bit-copy-generation" }
+...
+
+# CopyGeneration recognizes the duplicate masks and replaces the second value.
+# CHECK-LABEL: name: copygen
+# CHECK: %[[MASK:[0-9]+]]:intregs = A2_andir %{{[0-9]+}}, 255
+# CHECK-NOT: A2_andir
+# CHECK: A2_add %[[MASK]], %[[MASK]]
+
+---
+name: copygen
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $r0
+    %0:intregs = COPY $r0
+    %1:intregs = A2_andir %0, 255
+    %2:intregs = A2_andir %0, 255
+    %3:intregs = A2_add %1, %2
+    $r0 = COPY %3
+    PS_jmpret $r31, implicit-def dead $pc, implicit $r0
+...
+
+# The per-function safety attribute leaves both independently computed values
+# in place while the other Hexagon bit simplifications remain enabled.
+# CHECK-LABEL: name: no_copygen
+# CHECK: %[[MASK0:[0-9]+]]:intregs = A2_andir %{{[0-9]+}}, 255
+# CHECK: %[[MASK1:[0-9]+]]:intregs = A2_andir %{{[0-9]+}}, 255
+# CHECK: A2_add %[[MASK0]], %[[MASK1]]
+
+---
+name: no_copygen
+tracksRegLiveness: true
+body: |
+  bb.0:
+    liveins: $r0
+    %0:intregs = COPY $r0
+    %1:intregs = A2_andir %0, 255
+    %2:intregs = A2_andir %0, 255
+    %3:intregs = A2_add %1, %2
+    $r0 = COPY %3
+    PS_jmpret $r31, implicit-def dead $pc, implicit $r0
+...
