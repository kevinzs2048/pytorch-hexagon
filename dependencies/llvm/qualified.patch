+; RUN: llc -mtriple=hexagon -mcpu=hexagonv73 -mattr=+hvxv73,+hvx-length128b,-hvx-qfloat,+hvx-ieee-fp < %s | FileCheck %s --check-prefix=IEEE
+; RUN: llc -mtriple=hexagon -mcpu=hexagonv73 -mattr=+hvxv73,+hvx-length128b,-hvx-qfloat,+hvx-ieee-fp -enable-unsafe-fp-math -enable-no-signed-zeros-fp-math < %s | FileCheck %s --check-prefix=IEEE
+; RUN: llc -mtriple=hexagon -mcpu=hexagonv68 -mattr=+hvxv68,+hvx-length128b,+hvx-qfloat,-hvx-ieee-fp < %s | FileCheck %s --check-prefix=INTEGER
+
+; IEEE HVX can convert two exact 16-bit pieces and round just once in the
+; final addition. HVX without IEEE FP32 arithmetic still needs normalization and rounding.
+; IEEE-LABEL: sitofp_v32i32:
+; IEEE-NOT: vcl0
+; IEEE: .sf = vadd(
+; IEEE: .sf = vadd(
+; IEEE: .sf = vadd(
+; IEEE-NOT: vcl0
+; INTEGER-LABEL: sitofp_v32i32:
+; INTEGER: vcl0
+define void @sitofp_v32i32(ptr %out, ptr %in) {
+  %x = load <32 x i32>, ptr %in, align 128
+  %y = sitofp <32 x i32> %x to <32 x float>
+  store <32 x float> %y, ptr %out, align 128
+  ret void
+}
+
+; IEEE-LABEL: uitofp_v32i32:
+; IEEE-NOT: vcl0
+; IEEE: .sf = vadd(
+; IEEE: .sf = vadd(
+; IEEE: .sf = vadd(
+; IEEE-NOT: vcl0
+; INTEGER-LABEL: uitofp_v32i32:
+; INTEGER: vcl0
+define void @uitofp_v32i32(ptr %out, ptr %in) {
+  %x = load <32 x i32>, ptr %in, align 128
+  %y = uitofp <32 x i32> %x to <32 x float>
+  store <32 x float> %y, ptr %out, align 128
+  ret void
+}
