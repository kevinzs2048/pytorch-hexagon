+; HVX128: memub(r1+#128)
+; HVX128: memb(r0+#128)
+; HVX128: = vmemu(r1+#0)
+; HVX128: vmemu(r0+#0) = v
+;
+; HVX128-LABEL: copy64:
+; HVX128: call __hexagon_memcpy_likely_aligned_min32bytes_mult8bytes
+; HVX64-LABEL: copy64:
+; HVX64: = vmem(r1+#0)
+; HVX64-NOT: call
+; HVX64: vmem(r0+#0) = v
+;
+; HVX128-LABEL: set128:
+; HVX128: vsplat
+; HVX128-NOT: call
+; HVX128: vmemu(r0+#0) = v
+;
+; HVX128-LABEL: move256:
+; HVX128-COUNT-2: = vmemu(r1+
+; HVX128-COUNT-2: vmemu(r0+
+; HVX128-NOT: call
+; HVX128: .Lfunc_end
+target triple = "hexagon"
+define void @copy128(ptr %dst, ptr %src) {
+ call void @llvm.memcpy.p0.p0.i32(ptr align 64 %dst, ptr align 64 %src, i32 128, i1 false)
+ ret void
+}
+define void @copy129_unaligned(ptr %dst, ptr %src) {
+ call void @llvm.memcpy.p0.p0.i32(ptr align 1 %dst, ptr align 1 %src, i32 129, i1 false)
+ ret void
+}
+define void @copy64(ptr %dst, ptr %src) {
+ call void @llvm.memcpy.p0.p0.i32(ptr align 64 %dst, ptr align 64 %src, i32 64, i1 false)
+ ret void
+}
+define void @set128(ptr %dst, i8 %byte) {
+ call void @llvm.memset.p0.i32(ptr align 4 %dst, i8 %byte, i32 128, i1 false)
+ ret void
+}
+define void @move256(ptr %dst, ptr %src) {
+ call void @llvm.memmove.p0.p0.i32(ptr align 1 %dst, ptr align 1 %src, i32 256, i1 false)
+ ret void
+}
+declare void @llvm.memcpy.p0.p0.i32(ptr,ptr,i32,i1)
+declare void @llvm.memset.p0.i32(ptr,i8,i32,i1)
+declare void @llvm.memmove.p0.p0.i32(ptr,ptr,i32,i1)
