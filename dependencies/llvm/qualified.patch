+# RUN: llc -mtriple=hexagon -run-pass prologepilog %s -o - | FileCheck %s
+# Instruction selection only knew about 64-byte-aligned locals. Register
+# allocation then introduced a 128-byte HVX spill. AP must be upgraded too:
+# aligning SP alone cannot make AP-relative vector stores properly aligned.
+# CHECK-LABEL: name: late_vector_spill
+# CHECK: $r16 = PS_aligna 128
+# CHECK: V6_vS32b_ai $r16,
+---
+name: late_vector_spill
+tracksRegLiveness: true
+stack:
+  - { id: 0, type: variable-sized, offset: 0, alignment: 64 }
+  - { id: 1, type: spill-slot, size: 128, alignment: 128 }
+body: |
+  bb.0:
+    liveins: $q0
+    $r16 = PS_aligna 64, implicit $r30
+    PS_vstorerq_ai %stack.1, 0, $q0
+...
